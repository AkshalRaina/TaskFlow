# Postgres connection used by the app (matches docker-compose defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow"

# Separate database used by the test suite (it is wiped between tests)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_test"

# Long random string used to sign login tokens, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"

# Frontend origin allowed by CORS
CLIENT_URL="http://localhost:3000"

PORT=4000

# ---- Email (optional) ----
# Leave SMTP_HOST empty to print emails (with their links) in the backend terminal instead of sending them.
# Local inbox for testing: run Mailpit (docker compose starts it, or `brew install mailpit && mailpit`),
# then use SMTP_HOST=localhost SMTP_PORT=1025 and open http://localhost:8025 to read the emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TaskFlow <no-reply@taskflow.local>"
